{
  "name": "playlist-pomodoro-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Application web combinant gestion de tâches Pomodoro, ambiances sonores et éclairage intelligent.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clarco-Mada-digital/pomodoro.git"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces --if-present",
    "db:check": "node server/scripts/check-db.js",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=18"
  }
}
